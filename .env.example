# OpenRouter API Key (supports multiple providers)
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: Specify custom model (default: inclusionai/ling-2.6-flash:free)
# OPENROUTER_MODEL=inclusionai/ling-2.6-flash:free

# Optional: If your network requires an outbound proxy
# Example (common Clash default):
# OPENROUTER_PROXY_URL=http://127.0.0.1:10808
